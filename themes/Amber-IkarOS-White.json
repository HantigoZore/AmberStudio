	"tokenColors": [
		{
			"scope": [
				"comment",
				"punctuation.definition.comment"
			],
			"settings": {
				"foreground": "#6e6662",
				"fontStyle": "italic"
			}
		},
		{
			"scope": [
				"keyword",
				"storage.type",
				"storage.modifier",
				"keyword.control",
				"keyword.operator.new",
				"keyword.operator.expression",
				"keyword.operator.logical",
				"keyword.operator.delete",
				"variable.language"
			],
			"settings": {
				"foreground": "#c73300",
				"fontStyle": "bold"
			}
		},
		{
			"scope": [
				"entity.name.function",
				"meta.function-call",
				"support.function",
				"entity.name.method",
				"meta.method-call"
			],
			"settings": {
				"foreground": "#8a6800"
			}
		},
		{
			"scope": [
				"entity.name.type",
				"entity.name.class",
				"support.class",
				"support.type"
			],
			"settings": {
				"foreground": "#1a4a7a"
			}
		},
		{
			"scope": [
				"string",
				"punctuation.definition.string",
				"string.quoted"
			],
			"settings": {
				"foreground": "#3a7a3a"
			}
		},
		{
			"scope": [
				"constant.numeric",
				"constant.language.boolean",
				"constant.language.null",
				"constant.language.undefined",
				"support.constant"
			],
			"settings": {
				"foreground": "#7a3a58"
			}
		},
		{
			"scope": [
				"variable",
				"variable.parameter",
				"variable.other",
				"variable.name"
			],
			"settings": {
				"foreground": "#1a1614"
			}
		},
		{
			"scope": [
				"variable.other.property",
				"meta.property.object",
				"support.variable.property"
			],
			"settings": {
				"foreground": "#1a6a6a"
			}
		},
		{
			"scope": [
				"punctuation",
				"meta.brace",
				"punctuation.definition.parameters",
				"punctuation.definition.block",
				"keyword.operator.assignment",
				"keyword.operator.arithmetic"
			],
			"settings": {
				"foreground": "#4a4440"
			}
		},
		{
			"scope": [
				"entity.name.tag",
				"meta.tag.sgml",
				"punctuation.definition.tag"
			],
			"settings": {
				"foreground": "#c73300"
			}
		},
		{
			"scope": [
				"entity.other.attribute-name"
			],
			"settings": {
				"foreground": "#8a6800",
				"fontStyle": "italic"
			}
		},
		{
			"scope": [
				"markup.heading",
				"markup.heading entity.name"
			],
			"settings": {
				"foreground": "#c73300",
				"fontStyle": "bold"
			}
		},
		{
			"scope": [
				"markup.bold"
			],
			"settings": {
				"fontStyle": "bold",
				"foreground": "#8a6800"
			}
		},
		{
			"scope": [
				"markup.italic"
			],
			"settings": {
				"fontStyle": "italic",
				"foreground": "#1a6a6a"
			}
		},
		{
			"scope": [
				"markup.inline.raw"
			],
			"settings": {
				"foreground": "#3a7a3a"
			}
		},
		{
			"scope": [
				"invalid",
				"invalid.illegal"
			],
			"settings": {
				"foreground": "#ffffff",
				"background": "#ba1a1a"
			}
		}
	],
	"semanticTokenColors": {
		"variable.declaration": {
			"foreground": "#1a1614"
		},
		"variable.readonly": {
			"foreground": "#7a3a58"
		},
		"function": {
			"foreground": "#8a6800"
		},
		"class": {
			"foreground": "#1a4a7a"
		},
		"interface": {
			"foreground": "#1a4a7a",
			"fontStyle": "italic"
		},
		"property": {
			"foreground": "#1a6a6a"
		},
		"keyword": {
			"foreground": "#c73300"
		},
		"string": {
			"foreground": "#3a7a3a"
		},
		"number": {
			"foreground": "#7a3a58"
		}
	}
}