	"tokenColors": [
		{
			"scope": [
				"comment",
				"punctuation.definition.comment"
			],
			"settings": {
				"foreground": "#a09890",
				"fontStyle": "italic"
			}
		},
		{
			"scope": [
				"keyword",
				"storage.type",
				"storage.modifier",
				"keyword.control",
				"keyword.operator.new",
				"keyword.operator.expression",
				"keyword.operator.logical",
				"keyword.operator.delete",
				"variable.language"
			],
			"settings": {
				"foreground": "#ff4500",
				"fontStyle": "bold"
			}
		},
		{
			"scope": [
				"entity.name.function",
				"meta.function-call",
				"support.function",
				"entity.name.method",
				"meta.method-call"
			],
			"settings": {
				"foreground": "#e0c080"
			}
		},
		{
			"scope": [
				"entity.name.type",
				"entity.name.class",
				"support.class",
				"support.type"
			],
			"settings": {
				"foreground": "#80aad0"
			}
		},
		{
			"scope": [
				"string",
				"punctuation.definition.string",
				"string.quoted"
			],
			"settings": {
				"foreground": "#8acc8a"
			}
		},
		{
			"scope": [
				"constant.numeric",
				"constant.language.boolean",
				"constant.language.null",
				"constant.language.undefined",
				"support.constant"
			],
			"settings": {
				"foreground": "#c088a8"
			}
		},
		{
			"scope": [
				"variable",
				"variable.parameter",
				"variable.other",
				"variable.name"
			],
			"settings": {
				"foreground": "#e4ddd8"
			}
		},
		{
			"scope": [
				"variable.other.property",
				"meta.property.object",
				"support.variable.property"
			],
			"settings": {
				"foreground": "#6ac0c0"
			}
		},
		{
			"scope": [
				"punctuation",
				"meta.brace",
				"punctuation.definition.parameters",
				"punctuation.definition.block",
				"keyword.operator.assignment",
				"keyword.operator.arithmetic"
			],
			"settings": {
				"foreground": "#c8c0b8"
			}
		},
		{
			"scope": [
				"entity.name.tag",
				"meta.tag.sgml",
				"punctuation.definition.tag"
			],
			"settings": {
				"foreground": "#ff4500"
			}
		},
		{
			"scope": [
				"entity.other.attribute-name"
			],
			"settings": {
				"foreground": "#e0c080",
				"fontStyle": "italic"
			}
		},
		{
			"scope": [
				"markup.heading",
				"markup.heading entity.name"
			],
			"settings": {
				"foreground": "#ff4500",
				"fontStyle": "bold"
			}
		},
		{
			"scope": [
				"markup.bold"
			],
			"settings": {
				"fontStyle": "bold",
				"foreground": "#e0c080"
			}
		},
		{
			"scope": [
				"markup.italic"
			],
			"settings": {
				"fontStyle": "italic",
				"foreground": "#6ac0c0"
			}
		},
		{
			"scope": [
				"markup.inline.raw"
			],
			"settings": {
				"foreground": "#8acc8a"
			}
		},
		{
			"scope": [
				"invalid",
				"invalid.illegal"
			],
			"settings": {
				"foreground": "#ffffff",
				"background": "#d94f5a"
			}
		}
	],
	"semanticTokenColors": {
		"variable.declaration": {
			"foreground": "#e4ddd8"
		},
		"variable.readonly": {
			"foreground": "#c088a8"
		},
		"function": {
			"foreground": "#e0c080"
		},
		"class": {
			"foreground": "#80aad0"
		},
		"interface": {
			"foreground": "#80aad0",
			"fontStyle": "italic"
		},
		"property": {
			"foreground": "#6ac0c0"
		},
		"keyword": {
			"foreground": "#ff4500"
		},
		"string": {
			"foreground": "#8acc8a"
		},
		"number": {
			"foreground": "#c088a8"
		}
	}
}